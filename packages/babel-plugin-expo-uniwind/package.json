{
  "name": "babel-plugin-expo-uniwind",
  "version": "1.0.0",
  "license": "MIT",
  "main": "build/babel.js",
  "types": "build/babel.d.ts",
  "source": "src/babel.ts",
  "exports": {
    ".": {
      "types": "./build/babel.d.ts",
      "default": "./build/babel.js"
    },
    "./babel": {
      "types": "./build/babel.d.ts",
      "default": "./build/babel.js"
    },
    "./components/*": "./build/components/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo lint",
    "test": "expo-module test",
    "prepare": "expo-module prepare",
    "postinstall": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly"
  },
  "peerDependencies": {
    "@legendapp/list": "*",
    "expo-image": "*",
    "expo-video": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "uniwind": "*"
  },
  "peerDependenciesMeta": {
    "@legendapp/list": { "optional": true },
    "expo-image": { "optional": true },
    "expo-video": { "optional": true },
    "react-native-safe-area-context": { "optional": true }
  },
  "devDependencies": {
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "expo-module-scripts": "^56.0.3"
  }
}
